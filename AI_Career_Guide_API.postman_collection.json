	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-save access token from login response",
					"if (pm.response.code === 200 && pm.request.url.path.includes('login')) {",
					"    const response = pm.response.json();",
					"    if (response.access_token) {",
					"        pm.environment.set('access_token', response.access_token);",
					"        console.log('Access token saved:', response.access_token);",
					"    }",
					"    if (response.user) {",
					"        pm.environment.set('user_id', response.user.id);",
					"        console.log('User ID saved:', response.user.id);",
					"    }",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string",
			"description": "Base URL for the Laravel API server"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string",
			"description": "Bearer token for authenticated requests (auto-filled after login)"
		},
		{
			"key": "user_id",
			"value": "",
			"type": "string",
			"description": "Current user ID (auto-filled after login)"
		}
	]
